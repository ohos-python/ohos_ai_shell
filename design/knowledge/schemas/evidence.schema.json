{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "urn:aishell:schema:knowledge:evidence:0.1.0",
  "title": "AIShell Evidence",
  "type": "object", "additionalProperties": false,
  "required": ["schema_version", "kind", "id", "revision", "evidence_type", "title", "content", "visibility", "source", "applicability", "claims", "review"],
  "properties": {
    "schema_version": {"const": "0.1.0"},
    "kind": {"const": "Evidence"},
    "id": {"$ref": "urn:aishell:schema:knowledge:common:0.1.0#/$defs/id"},
    "revision": {"$ref": "urn:aishell:schema:knowledge:common:0.1.0#/$defs/revision"},
    "evidence_type": {"enum": ["guide", "release_note", "issue_report", "test_report", "environment_observation"]},
    "title": {"type": "string", "minLength": 1},
    "content": {"type": "string", "minLength": 1},
    "visibility": {
      "type": "object", "additionalProperties": false,
      "required": ["scope"],
      "properties": {
        "scope": {"enum": ["public", "session"]},
        "session_id": {"type": "string", "minLength": 1},
        "retain_until": {"type": "string", "format": "date-time"}
      },
      "allOf": [
        {"if": {"properties": {"scope": {"const": "session"}}}, "then": {"required": ["session_id", "retain_until"]}},
        {"if": {"properties": {"scope": {"const": "public"}}}, "then": {"not": {"anyOf": [{"required": ["session_id"]}, {"required": ["retain_until"]}]}}}
      ]
    },
    "source": {
      "type": "object", "additionalProperties": false,
      "required": ["uri", "revision", "locator", "captured_at", "captured_by", "snapshot_path", "sha256", "rights_status"],
      "properties": {
        "uri": {"type": "string", "format": "uri"},
        "revision": {"type": "string", "minLength": 1},
        "locator": {"type": "string", "minLength": 1},
        "captured_at": {"type": "string", "format": "date-time"},
        "captured_by": {"type": "string", "minLength": 1},
        "snapshot_path": {"$ref": "urn:aishell:schema:knowledge:common:0.1.0#/$defs/path"},
        "sha256": {"$ref": "urn:aishell:schema:knowledge:common:0.1.0#/$defs/digest"},
        "rights_status": {"enum": ["cleared", "pending", "example_only"]},
        "license_expression": {"type": "string", "minLength": 1},
        "rights_record_ref": {"type": "string", "minLength": 1}
      },
      "allOf": [{"if": {"properties": {"rights_status": {"const": "cleared"}}}, "then": {"required": ["license_expression", "rights_record_ref"]}}]
    },
    "applicability": {"$ref": "urn:aishell:schema:knowledge:common:0.1.0#/$defs/applicability"},
    "claims": {
      "type": "array", "minItems": 1,
      "items": {
        "type": "object", "additionalProperties": false,
        "required": ["text", "status"],
        "properties": {
          "text": {"type": "string", "minLength": 1},
          "status": {"enum": ["source_statement", "observed", "hypothesis"]}
        }
      }
    },
    "review": {"$ref": "urn:aishell:schema:knowledge:common:0.1.0#/$defs/review"}
  }
}
